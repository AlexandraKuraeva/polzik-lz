# Локальный стенд в Docker (профиль local). Не путать с .env.local — его читает npm run dev.
# Создать .env с новыми секретами:
#   docker run --rm -v "$PWD":/app -w /app node:22-alpine node scripts/generate-env.mjs .env.example > .env
# Сервер — образец .env.vps.example.

COMPOSE_PROFILES=local

# --- Supabase (пустые значения заполняет scripts/generate-env.mjs)
# Пароль postgres и служебных ролей (только буквы и цифры — подставляется в URL подключения)
POSTGRES_PASSWORD=
# Секрет подписи ключей API, не короче 32 символов
JWT_SECRET=
# Ключи API — JWT, подписанные JWT_SECRET (role: anon / service_role)
ANON_KEY=
SERVICE_ROLE_KEY=
# Ключ шифрования postgres-meta (Studio), не короче 32 символов
PG_META_CRYPTO_KEY=
JWT_EXPIRY=3600

# --- Сервис: секрет next-auth (подпись сессий)
AUTH_SECRET=

# --- Порты на хосте
APP_PORT=3000
STUDIO_PORT=54323
