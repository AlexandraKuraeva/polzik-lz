# Переменные для docker compose (сервер). Локальная разработка (npm run dev) этот файл
# не использует — там .env.local с облачным или локальным Supabase.
#
# Заполнить секреты автоматически (создаст .env):
#   docker run --rm -v "$PWD":/app -w /app node:22-alpine node scripts/generate-env.mjs > .env
# Секреты после первого запуска не менять: POSTGRES_PASSWORD и JWT_SECRET
# уже записаны в базу и в выданные ключи.

# --- Supabase ---

# Пароль postgres и служебных ролей (только буквы и цифры — он подставляется в URL подключения)
POSTGRES_PASSWORD=
# Секрет для подписи ключей API, не короче 32 символов
JWT_SECRET=
# Ключи API — JWT, подписанные JWT_SECRET (role: anon / service_role)
ANON_KEY=
SERVICE_ROLE_KEY=
# Ключ шифрования для postgres-meta (Studio), не короче 32 символов
PG_META_CRYPTO_KEY=
JWT_EXPIRY=3600

# --- Сервис ---

# Секрет next-auth (подпись сессий)
AUTH_SECRET=

# --- Порты на хосте ---

# Сервис. Наружу обычно открывается через nginx/traefik с HTTPS
APP_PORT=3000
# Studio, слушает только 127.0.0.1
STUDIO_PORT=54323
