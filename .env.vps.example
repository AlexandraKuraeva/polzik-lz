# Сервер (профиль vps): сервис за traefik. В папке клона на VPS:
#   docker run --rm -v "$PWD":/app -w /app node:22-alpine node scripts/generate-env.mjs .env.vps.example > .env
#   ./scripts/vps-update.sh
# Порядок — DEPLOY.md. Знак $ в значениях compose читает как подстановку — удваивать: $$ (строки htpasswd).
# В git файл .env не попадает. Секреты после первого запуска не менять: POSTGRES_PASSWORD и JWT_SECRET
# записаны в базу и в выданные ключи.

COMPOSE_PROFILES=vps
# Имя экземпляра: имена контейнеров, томов и роутеров traefik
COMPOSE_PROJECT_NAME=polziks

# --- Домен сервиса (A-запись на IP VPS; traefik берёт сертификат через myresolver)
APP_DOMAIN=polziki.lz.media

# --- Пароль на весь сервис (basic-auth traefik) — по желанию; пусто = без пароля, вход только через
# логин сервиса. Строка htpasswd, знаки $ удвоены:
#   docker run --rm httpd:2.4-alpine htpasswd -nbB polziki 'пароль' | sed -e 's/\$/\$\$/g'
SITE_BASIC_AUTH_USERS=

# --- Админ: создаётся при старте сервиса, если пользователя с таким email нет. Существующий
# не меняется. Пустой ADMIN_EMAIL — не создавать: на сервере сотрудники обычно приходят из дампа
# (scripts/import-dump.sh), и лишний админ попал бы в список. Заполнить, если база стартует пустой.
ADMIN_EMAIL=
ADMIN_NAME=Админ
ADMIN_PASSWORD=

# --- Supabase (пустые значения заполняет scripts/generate-env.mjs)
POSTGRES_PASSWORD=
JWT_SECRET=
SERVICE_ROLE_KEY=
JWT_EXPIRY=3600

# --- Сервис: секрет next-auth (подпись сессий)
AUTH_SECRET=
